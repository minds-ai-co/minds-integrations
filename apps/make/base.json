{
  "baseUrl": "https://getminds.ai/api/v1",
  "headers": {
    "Authorization": "Bearer {{connection.apiKey}}",
    "Accept": "application/json"
  },
  "response": {
    "error": {
      "message": "[{{statusCode}}] {{ifempty(body.message, ifempty(body.statusMessage, 'The Minds request failed.'))}}",
      "401": {
        "type": "InvalidAccessTokenError",
        "message": "[401] Minds rejected the API key. Create a new key in Minds API settings and update the connection."
      },
      "403": {
        "type": "DataError",
        "message": "[403] {{ifempty(body.message, 'Minds denied access to this resource.')}}"
      },
      "404": {
        "type": "DataError",
        "message": "[404] {{ifempty(body.message, 'The requested Minds resource was not found.')}}"
      },
      "429": {
        "type": "RateLimitError",
        "message": "[429] Minds rate limit reached. Retry later."
      }
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization"
    ]
  }
}
