{
  "url": "https://getminds.ai/api/v1/auth/me",
  "method": "GET",
  "headers": {
    "Authorization": "Bearer {{parameters.apiKey}}",
    "Accept": "application/json"
  },
  "response": {
    "metadata": {
      "type": "text",
      "value": "Minds user {{substring(body.id, 0, 8)}}"
    },
    "error": {
      "message": "[{{statusCode}}] {{ifempty(body.message, 'The Minds API key could not be verified.')}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization"
    ]
  }
}
