[
  {
    "condition": "{{parameters.material == 'url'}}",
    "url": "/studies/{{parameters.studyId}}/research-plans/preview",
    "method": "POST",
    "type": "json",
    "body": {
      "request": "{{parameters.request}}",
      "studyLocale": "{{ifempty(parameters.studyLocale, 'en')}}",
      "idempotencyKey": "{{parameters.idempotencyKey}}",
      "source": {
        "kind": "{{ifempty(parameters.sourceKind, 'image')}}",
        "label": "{{ifempty(parameters.sourceLabel, 'Make material')}}",
        "url": "{{parameters.sourceUrl}}"
      }
    },
    "response": {
      "temp": {
        "preview": "{{body.data}}"
      }
    }
  },
  {
    "condition": "{{parameters.material == 'text'}}",
    "url": "/studies/{{parameters.studyId}}/research-plans/preview",
    "method": "POST",
    "type": "json",
    "body": {
      "request": "{{parameters.request}}",
      "studyLocale": "{{ifempty(parameters.studyLocale, 'en')}}",
      "idempotencyKey": "{{parameters.idempotencyKey}}",
      "source": {
        "kind": "prompt",
        "label": "{{ifempty(parameters.sourceLabel, 'Make material')}}",
        "content": "{{parameters.sourceContent}}"
      }
    },
    "response": {
      "temp": {
        "preview": "{{body.data}}"
      }
    }
  },
  {
    "condition": "{{parameters.material != 'url' && parameters.material != 'text'}}",
    "url": "/studies/{{parameters.studyId}}/research-plans/preview",
    "method": "POST",
    "type": "json",
    "body": {
      "request": "{{parameters.request}}",
      "studyLocale": "{{ifempty(parameters.studyLocale, 'en')}}",
      "idempotencyKey": "{{parameters.idempotencyKey}}"
    },
    "response": {
      "temp": {
        "preview": "{{body.data}}"
      }
    }
  },
  {
    "response": {
      "output": {
        "{{...}}": "{{temp.preview}}",
        "studyId": "{{parameters.studyId}}",
        "reviewUrl": "https://getminds.ai/?studyId={{encodeURL(parameters.studyId)}}&draftPlanId={{encodeURL(temp.preview.draftPlanId)}}"
      }
    }
  }
]
