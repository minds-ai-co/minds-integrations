{
  "url": "/studies",
  "method": "GET",
  "qs": {
    "limit": 100
  },
  "response": {
    "limit": "{{parameters.limit}}",
    "iterate": "{{body.data}}",
    "output": "{{item}}",
    "trigger": {
      "id": "{{item.id}}",
      "date": "{{item.createdAt}}",
      "type": "date",
      "order": "unordered"
    }
  },
  "pagination": {
    "qs": {
      "offset": "{{(pagination.page - 1) * 100}}"
    },
    "condition": "{{body.pagination.offset + body.pagination.limit < body.pagination.total}}"
  }
}
