{
  "url": "/studies",
  "method": "GET",
  "qs": {
    "limit": 100
  },
  "response": {
    "limit": 300,
    "iterate": "{{body.data}}",
    "output": {
      "label": "{{item.name}}",
      "date": "{{item.createdAt}}"
    }
  },
  "pagination": {
    "qs": {
      "offset": "{{(pagination.page - 1) * 100}}"
    },
    "condition": "{{body.pagination.offset + body.pagination.limit < body.pagination.total}}"
  }
}
