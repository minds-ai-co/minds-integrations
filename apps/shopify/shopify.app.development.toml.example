# Copy to shopify.app.toml after the backend is deployed to a reachable development URL.
client_id = "b8499982b1a038cc211e4c195c376c1d"
name = "Minds Research Dev"
application_url = "https://getminds.ai/shopify"
embedded = true

[access_scopes]
scopes = "read_products"

[auth]
redirect_urls = []

[webhooks]
api_version = "2026-07"

[[webhooks.subscriptions]]
topics = ["app/uninstalled"]
uri = "/shopify/webhooks/uninstalled"

# Activate only after the backend privacy routes and migrations are deployed.
[[webhooks.subscriptions]]
compliance_topics = ["customers/data_request"]
uri = "/shopify/webhooks/customers-data-request"

[[webhooks.subscriptions]]
compliance_topics = ["customers/redact"]
uri = "/shopify/webhooks/customers-redact"

[[webhooks.subscriptions]]
compliance_topics = ["shop/redact"]
uri = "/shopify/webhooks/shop-redact"
