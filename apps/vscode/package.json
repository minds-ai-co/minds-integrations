{
  "name": "minds-research-vscode",
  "displayName": "Minds Research",
  "description": "Plan reviewable synthetic market research from selected text and inspect your Minds Groups.",
  "version": "0.1.0",
  "private": true,
  "publisher": "minds-ai",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/minds-ai-co/minds-integrations.git",
    "directory": "apps/vscode"
  },
  "homepage": "https://getminds.ai/mcp/setup",
  "bugs": {
    "url": "https://github.com/minds-ai-co/minds-integrations/issues"
  },
  "files": [
    "dist/extension.js",
    "README.md",
    "LICENSE",
    "icon.png"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": ["Other", "Machine Learning"],
  "keywords": ["market research", "synthetic audience", "mcp", "product research"],
  "activationEvents": [
    "onCommand:minds.setApiKey",
    "onCommand:minds.listGroups",
    "onCommand:minds.planSelectedText"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "minds.setApiKey", "title": "Minds: Set API Key" },
      { "command": "minds.listGroups", "title": "Minds: Browse Research Groups" },
      { "command": "minds.planSelectedText", "title": "Minds: Plan Research for Selected Text" }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "minds.planSelectedText",
          "when": "editorHasSelection",
          "group": "navigation@90"
        }
      ]
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package:check": "npm run build && vsce package --no-dependencies --out dist/minds-research.vsix"
  },
  "dependencies": {
    "@minds/mcp-client": "0.1.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
